# ============================================================
# 快速开始
#   cp .env.example .env
#   然后把 OPENAI_API_KEY 替换成你自己的 Key，即可运行
# ============================================================


# ------------------------------------------------------------
# 一、LLM 配置（三选一，默认【火山方舟】）
# ------------------------------------------------------------

# ===== 方案 A：火山方舟（默认启用，国内可直接访问）=====
#
# 方舟对外提供 OpenAI 兼容接口，因此 LLM_PROVIDER 保持 openai 不变，
# 只需把 OPENAI_BASE_URL 指向方舟端点，业务代码零改动。
#
# 控制台：https://console.volcengine.com/ark
#
# ⚠️ 两个必做准备（漏了会报 404 / 403）：
#   1. 完成实名认证 —— 未认证无法调用任何模型
#   2. 在「开通管理」里开通目标模型 —— 方舟的 Key 不自动解锁模型
#
# 💰 新用户实名后，每个模型赠送 50 万 tokens（30 天有效）
#
# ------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-flash-ga-260731
OPENAI_API_KEY=替换为你的方舟APIKey
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 方舟常用模型：改 LLM_MODEL 这一行即可切换
#   deepseek-v4-flash-ga-260731    响应快，适合本 Demo（默认）
#   doubao-seed-2-0-mini-260215    最便宜
#   doubao-seed-2-0-lite-260215    性价比均衡
#   doubao-seed-2-0-pro-260215     质量最好
#   doubao-embedding-large         Embedding，用于 RAG

# ===== 方案 B：OpenAI 官方 =====
# 启用方式：把上方【方案 A】的 4 行全部注释掉，再取消注释下面 3 行
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-xxx
# 注意：官方地址不要设置 OPENAI_BASE_URL，留空反而会报错

# ===== 方案 C：Anthropic Claude =====
# 启用方式：注释掉【方案 A】，取消注释下面 3 行
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=sk-ant-xxx
# ⚠️ 换 provider 时必须同时改 LLM_MODEL，
#    OpenAI 的模型名（gpt-4o-mini 等）不能用在 anthropic 上


# ------------------------------------------------------------
# 二、Embedding（RAG 检索用）
# ------------------------------------------------------------
#   local  —— 本地中文模型（默认）：无需 API Key、离线可用、零调用成本，
#             clone 下来 pip install 就能跑通 RAG，首次运行自动下载模型（约 90MB）。
#   openai —— 任意 OpenAI 兼容服务（方舟 / OpenAI 官方 / 通义 / 本地 vLLM），
#             配合上面已配好的 OPENAI_BASE_URL 使用。
EMBEDDING_PROVIDER=local

# local 模式下填本地模型名；切到 openai 时换成对方平台的模型名或推理接入点 ID。
# ⚠️ 方舟 embedding 模型名都带日期后缀（如 doubao-embedding-large-text-250515），
#    且必须先在控制台开通，未开通会报 404 InvalidEndpointOrModel；
#    doubao-embedding-large 这种简写并不存在。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 未安装 llama-index 时，检索会自动降级为「无资料模式」，
# 主流程照常运行，不会中断。


# ------------------------------------------------------------
# 三、LangSmith 追踪（可选，默认关闭）
# ------------------------------------------------------------
# 设为 true 后，所有 LLM 调用自动上报到 LangSmith 后台
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langstack-demo


# ------------------------------------------------------------
# 四、数据目录
# ------------------------------------------------------------
DATA_DIR=./data
